#!/usr/bin/env bash
# Asimov - launch AI coding CLIs in full-autonomy mode with protocols + quality gate
# Personal tool, built for sandboxed environments. Claude Code, Gemini CLI, Codex CLI.
set -euo pipefail

ASIMOV_VERSION="3.0.0"
ASIMOV_REPO="mollendorff-ai/asimov"
ASIMOV_GLOBAL_DIR="${HOME}/.asimov"
ASIMOV_GLOBAL_CONFIG="${ASIMOV_GLOBAL_DIR}/config.yaml"
ASIMOV_PROJECT_CONFIG=".asimov/launch.yaml"
ASIMOV_PROTOCOLS=(freshness.json sycophancy.json sprint.json coding-standards.json)
ASIMOV_WARMUP_PROMPT="Read .asimov/roadmap.yaml. One-line summary of current sprint."

# Resolve data directory (protocols, hooks)
if [ -n "${ASIMOV_DATA:-}" ]; then
    DATA_DIR="$ASIMOV_DATA"
else
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    if [ -d "${SCRIPT_DIR}/../share/asimov" ]; then
        DATA_DIR="${SCRIPT_DIR}/../share/asimov"
    else
        DATA_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
    fi
fi

# ─── Dependency check ────────────────────────────────────────────────────

check_deps() {
    local missing=()
    command -v yq &>/dev/null || missing+=("yq")
    command -v jq &>/dev/null || missing+=("jq")
    if [ ${#missing[@]} -gt 0 ]; then
        echo "Missing dependencies: ${missing[*]}" >&2
        echo "Install:" >&2
        for dep in "${missing[@]}"; do
            case "$dep" in
                yq) echo "  brew install yq  # or: go install github.com/mikefarah/yq/v4@latest" >&2 ;;
                jq) echo "  brew install jq   # or: apt install jq" >&2 ;;
            esac
        done
        exit 1
    fi
    # Asimov needs mikefarah/yq (Go). The Python yq that `apt install yq`
    # provides on Debian/Ubuntu has a different syntax and breaks config edits.
    if ! yq --version 2>&1 | grep -qi mikefarah; then
        echo "Wrong yq: asimov needs mikefarah/yq v4 (the Go version)." >&2
        echo "Found: $(yq --version 2>&1 | head -1)" >&2
        echo "Install: brew install yq  # or: go install github.com/mikefarah/yq/v4@latest" >&2
        echo "         or download from https://github.com/mikefarah/yq/releases" >&2
        exit 1
    fi
}

# ─── Config helpers (yq/jq) ──────────────────────────────────────────────

# Read a YAML value: cfg_get file path (yq dot notation)
cfg_get() {
    [ -f "$1" ] || return 0
    local val
    val=$(yq -r "$2 // \"\"" "$1")
    [ "$val" != "null" ] && [ -n "$val" ] && echo "$val"
    return 0
}

# Read a YAML list as lines: cfg_list file path
cfg_list() {
    [ -f "$1" ] || return 0
    yq -r "$2 // [] | .[]" "$1" 2>/dev/null
    return 0
}

# Read a YAML map as KEY=VALUE lines: cfg_env file path
cfg_env() {
    [ -f "$1" ] || return 0
    yq -r "$2 // {} | to_entries[] | .key + \"=\" + .value" "$1" 2>/dev/null
    return 0
}

# ─── Default global config ───────────────────────────────────────────────

ensure_global_config() {
    [ -d "$ASIMOV_GLOBAL_DIR" ] && return 0
    mkdir -p "$ASIMOV_GLOBAL_DIR"
    cat > "$ASIMOV_GLOBAL_CONFIG" << 'YAML'
# Asimov - Global Configuration
# Docs: https://github.com/mollendorff-ai/asimov

launch:
  default_ai: claude

  claude:
    model: opus
    args:
      - --dangerously-skip-permissions
    env:
      MAX_THINKING_TOKENS: "1000000"
      CLAUDE_CODE_EFFORT_LEVEL: "max"
      CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS: "1"

  gemini:
    args:
      - --approval-mode=yolo

  codex:
    args:
      - --full-auto
YAML
    echo "Created global config: ${ASIMOV_GLOBAL_CONFIG}"
}

# Add env vars introduced after a config was created. Only writes when a key
# is actually missing, so the file (and its comments) is left alone otherwise.
migrate_global_config() {
    [ -f "$ASIMOV_GLOBAL_CONFIG" ] || return 0
    local key default
    for pair in "CLAUDE_CODE_EFFORT_LEVEL=max" "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1"; do
        key="${pair%%=*}"
        default="${pair#*=}"
        if ! yq -e ".launch.claude.env.${key}" "$ASIMOV_GLOBAL_CONFIG" &>/dev/null; then
            yq -i ".launch.claude.env.${key} = \"${default}\"" "$ASIMOV_GLOBAL_CONFIG"
        fi
    done
}

# ─── System prompt builder ───────────────────────────────────────────────

build_system_prompt() {
    [ -d .asimov ] || return 0

    local name="" type="" description="" stack="" conventions=""
    if [ -f .asimov/project.yaml ]; then
        name=$(cfg_get .asimov/project.yaml '.identity.name')
        type=$(cfg_get .asimov/project.yaml '.identity.type')
        description=$(cfg_get .asimov/project.yaml '.description')
        stack=$(yq -r '.stack // [] | join(", ")' .asimov/project.yaml 2>/dev/null)
        conventions=$(yq -r '.conventions // [] | join(" | ")' .asimov/project.yaml 2>/dev/null)
    fi
    # Strip TODO placeholder from injection
    [ "$description" = "TODO: describe your project" ] && description=""

    # Build compact JSON from protocols + project identity
    local freshness="" sycophancy="" sprint="" coding_standards=""
    [ -f .asimov/freshness.json ] && freshness=$(jq -r '.rule // empty' .asimov/freshness.json)
    [ -f .asimov/sycophancy.json ] && sycophancy=$(jq -r '.rule // empty' .asimov/sycophancy.json)
    [ -f .asimov/sprint.json ] && sprint=$(jq -r '.rule // empty' .asimov/sprint.json)
    [ -f .asimov/coding-standards.json ] && coding_standards=$(jq -r '.rule // empty' .asimov/coding-standards.json)

    # Need at least one thing to inject
    [ -z "$name" ] && [ -z "$freshness" ] && [ -z "$sycophancy" ] && [ -z "$sprint" ] && [ -z "$coding_standards" ] && return 0

    jq -c -n \
        --arg name "$name" \
        --arg type "$type" \
        --arg description "$description" \
        --arg stack "$stack" \
        --arg conventions "$conventions" \
        --arg freshness "$freshness" \
        --arg sycophancy "$sycophancy" \
        --arg sprint "$sprint" \
        --arg coding_standards "$coding_standards" \
        '{project:{name:$name,type:$type,description:$description,stack:$stack,conventions:$conventions},protocols:{freshness:$freshness,sycophancy:$sycophancy,sprint:$sprint,coding_standards:$coding_standards}}'
}

# ─── AI detection and launch ─────────────────────────────────────────────

is_inside_session() {
    [ -n "${CLAUDECODE:-}" ] || [ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ] && echo "Claude Code" && return 0
    [ -n "${GEMINI_CLI:-}" ] && echo "Gemini CLI" && return 0
    [ -n "${CODEX_CLI:-}" ] && echo "Codex CLI" && return 0
    return 1
}

detect_ai() {
    local found=()
    command -v claude &>/dev/null && found+=("claude")
    command -v gemini &>/dev/null && found+=("gemini")
    command -v codex &>/dev/null && found+=("codex")

    if [ ${#found[@]} -eq 0 ]; then
        echo "No AI CLI found. Install one of:" >&2
        echo "  Claude Code: https://docs.anthropic.com/en/docs/claude-code" >&2
        echo "  Gemini CLI:  https://github.com/google-gemini/gemini-cli" >&2
        echo "  Codex CLI:   https://github.com/openai/codex" >&2
        exit 1
    elif [ ${#found[@]} -eq 1 ]; then
        echo "${found[0]}"
    else
        echo "Multiple AI CLIs found: ${found[*]}" >&2
        echo "Set default_ai in ${ASIMOV_GLOBAL_CONFIG}" >&2
        select ai in "${found[@]}"; do
            [ -n "$ai" ] && echo "$ai" && return 0
        done
    fi
}

launch_ai() {
    check_deps
    ensure_global_config
    migrate_global_config

    # Check if inside an AI session already
    local session
    if session=$(is_inside_session); then
        echo "Inside ${session} session. Protocols active via system prompt."
        exit 0
    fi

    # Determine which AI to use
    local ai
    ai=$(cfg_get "$ASIMOV_PROJECT_CONFIG" '.launch.default_ai')
    [ -z "$ai" ] && ai=$(cfg_get "$ASIMOV_GLOBAL_CONFIG" '.launch.default_ai')
    if [ -n "$ai" ] && ! command -v "$ai" &>/dev/null; then
        echo "Configured AI '${ai}' not found, detecting..." >&2
        ai=""
    fi
    [ -z "$ai" ] && ai=$(detect_ai)

    # Load config: project overrides global
    local model args_list env_list
    model=$(cfg_get "$ASIMOV_PROJECT_CONFIG" ".launch.${ai}.model")
    [ -z "$model" ] && model=$(cfg_get "$ASIMOV_GLOBAL_CONFIG" ".launch.${ai}.model")
    args_list=$(cfg_list "$ASIMOV_PROJECT_CONFIG" ".launch.${ai}.args")
    [ -z "$args_list" ] && args_list=$(cfg_list "$ASIMOV_GLOBAL_CONFIG" ".launch.${ai}.args")
    env_list=$(cfg_env "$ASIMOV_PROJECT_CONFIG" ".launch.${ai}.env")
    [ -z "$env_list" ] && env_list=$(cfg_env "$ASIMOV_GLOBAL_CONFIG" ".launch.${ai}.env")

    # Hardcoded defaults if no config
    if [ -z "$args_list" ]; then
        case "$ai" in
            claude) args_list="--dangerously-skip-permissions" ;;
            gemini) args_list="--approval-mode=yolo" ;;
            codex)  args_list="--full-auto" ;;
        esac
    fi
    if [ -z "$model" ]; then
        case "$ai" in claude) model="opus" ;; esac
    fi
    if [ -z "$env_list" ]; then
        case "$ai" in claude) env_list="MAX_THINKING_TOKENS=1000000" ;; esac
    fi

    # Set env vars (line is KEY=VALUE, not a variable name)
    while IFS= read -r line; do
        # shellcheck disable=SC2163
        [ -n "$line" ] && export "$line"
    done <<< "$env_list"

    # Build args array
    local args=()
    while IFS= read -r arg; do
        [ -n "$arg" ] && args+=("$arg")
    done <<< "$args_list"
    [ -n "$model" ] && args+=("--model" "$model")

    # Ensure protocols are up to date (sync missing from data dir)
    if [ -d .asimov ]; then
        for f in "${ASIMOV_PROTOCOLS[@]}"; do
            if [ ! -f ".asimov/${f}" ] && [ -f "${DATA_DIR}/protocols/${f}" ]; then
                cp "${DATA_DIR}/protocols/${f}" ".asimov/${f}"
            fi
        done
    fi

    # Warn if project description is missing
    if [ -d .asimov ] && [ -f .asimov/project.yaml ]; then
        local desc
        desc=$(cfg_get .asimov/project.yaml '.description')
        if [ -z "$desc" ] || [ "$desc" = "TODO: describe your project" ]; then
            echo "Warning: .asimov/project.yaml has no description. Fill it in for better AI context." >&2
        fi
    fi

    local sys_prompt
    sys_prompt=$(build_system_prompt)

    # Claude: protocols go in the system prompt (outside the compacted
    # transcript), then a warmup turn reads the roadmap, then interactive.
    if [ "$ai" = "claude" ]; then
        [ -n "$sys_prompt" ] && args+=("--append-system-prompt" "$sys_prompt")
        if [ -f .asimov/roadmap.yaml ]; then
            echo "Warming up..."
            "$ai" "${args[@]}" -p "$ASIMOV_WARMUP_PROMPT"
            echo ""
            exec "$ai" "${args[@]}" --continue
        fi
        echo "Launching ${ai}..."
        exec "$ai" "${args[@]}"
    fi

    # Gemini and Codex have no append-system-prompt flag, so protocols and
    # the roadmap warmup are sent as the first message of the interactive
    # session. Unlike Claude's system prompt, this can be lost on compaction.
    local first_msg
    first_msg=$(build_first_message "$sys_prompt")
    echo "Launching ${ai}..."
    if [ -n "$first_msg" ]; then
        case "$ai" in
            gemini) exec "$ai" "${args[@]}" --prompt-interactive "$first_msg" ;;
            codex)  exec "$ai" "${args[@]}" "$first_msg" ;;
        esac
    fi
    exec "$ai" "${args[@]}"
}

# First interactive message for AIs without a system-prompt flag
build_first_message() {
    local sys_prompt="$1" msg=""
    if [ -n "$sys_prompt" ]; then
        msg="Follow these project rules for the whole session (JSON): ${sys_prompt}"
    fi
    if [ -f .asimov/roadmap.yaml ]; then
        msg="${msg:+${msg}

}${ASIMOV_WARMUP_PROMPT}"
    fi
    [ -n "$msg" ] && printf '%s' "$msg"
    return 0
}

# ─── Init ────────────────────────────────────────────────────────────────

cmd_init() {
    check_deps
    local name="${1:-$(basename "$(pwd)")}"

    if [ -d ".asimov" ]; then
        echo ".asimov/ already exists. Remove it first to reinitialize." >&2
        exit 1
    fi

    # Detect project type
    local ptype="generic"
    if [ -f Cargo.toml ]; then ptype="rust"
    elif [ -f package.json ]; then ptype="node"
    elif [ -f pyproject.toml ] || [ -f setup.py ]; then ptype="python"
    elif [ -f go.mod ]; then ptype="go"
    elif [ -f pubspec.yaml ]; then ptype="flutter"
    fi

    # Create .asimov/ with 4 protocols
    mkdir -p .asimov
    for f in "${ASIMOV_PROTOCOLS[@]}"; do
        if [ -f "${DATA_DIR}/protocols/${f}" ]; then
            cp "${DATA_DIR}/protocols/${f}" ".asimov/${f}"
        fi
    done

    # Generate project.yaml
    cat > .asimov/project.yaml << YAML
identity:
  name: "${name}"
  type: ${ptype}

description: "TODO: describe your project"

stack: []

conventions: []
YAML

    # Generate roadmap.yaml
    cat > .asimov/roadmap.yaml << 'YAML'
current:
  version: "0.1.0"
  title: "Initial setup"
  status: pending
  deliverables:
    - "Define project goals"
    - "Set up development environment"

backlog: []
YAML

    # Install pre-commit hook
    if [ -d .git ]; then
        mkdir -p .git/hooks
        if [ -f "${DATA_DIR}/hooks/pre-commit" ]; then
            cp "${DATA_DIR}/hooks/pre-commit" .git/hooks/pre-commit
            chmod +x .git/hooks/pre-commit
            echo "Installed pre-commit hook"
        fi
    else
        echo "Warning: not a git repo. Run 'git init' to get the pre-commit hook."
    fi

    echo ""
    echo "Initialized .asimov/ for '${name}' (${ptype})"
    echo ""
    echo "Files created:"
    echo "  .asimov/project.yaml"
    echo "  .asimov/roadmap.yaml"
    echo "  .asimov/freshness.json"
    echo "  .asimov/sycophancy.json"
    echo "  .asimov/sprint.json"
    echo "  .asimov/coding-standards.json"
    echo ""
    echo "Next: edit .asimov/project.yaml, then run 'asimov' to start"
}

# ─── Migrate ─────────────────────────────────────────────────────────────

cmd_migrate() {
    if [ ! -d ".asimov" ]; then
        echo "No .asimov/ directory found. Nothing to migrate." >&2
        exit 1
    fi

    check_deps
    local changed=0

    # Remove old cruft files
    for f in warmup.json asimov.json green.json migrations.json; do
        if [ -f ".asimov/${f}" ]; then
            rm ".asimov/${f}"
            echo "Removed .asimov/${f}"
            changed=1
        fi
    done

    # Remove old cruft directories
    for d in roles templates hooks protocols; do
        if [ -d ".asimov/${d}" ]; then
            rm -rf ".asimov/${d}"
            echo "Removed .asimov/${d}/"
            changed=1
        fi
    done

    # Old asimov versions generated bootstrap files in the project root.
    # Never delete them: they may hold your own instructions now.
    for f in CLAUDE.md GEMINI.md CODEX.md; do
        if [ -f "$f" ]; then
            echo "Note: ${f} kept. Older asimov versions generated it; delete it yourself if you no longer need it."
        fi
    done

    # Clean up and enrich project.yaml
    if [ -f .asimov/project.yaml ]; then
        # Remove legacy keys
        for key in quality files; do
            if yq -e ".${key}" .asimov/project.yaml &>/dev/null; then
                yq -i "del(.${key})" .asimov/project.yaml
                echo "Removed legacy '${key}' from project.yaml"
                changed=1
            fi
        done

        # Add new fields if missing
        if ! yq -e '.description' .asimov/project.yaml &>/dev/null; then
            yq -i '.description = "TODO: describe your project"' .asimov/project.yaml
            echo "Added 'description' to project.yaml (fill it in!)"
            changed=1
        fi
        if ! yq -e '.stack' .asimov/project.yaml &>/dev/null; then
            yq -i '.stack = []' .asimov/project.yaml
            echo "Added 'stack' to project.yaml"
            changed=1
        fi
        if ! yq -e '.conventions' .asimov/project.yaml &>/dev/null; then
            yq -i '.conventions = []' .asimov/project.yaml
            echo "Added 'conventions' to project.yaml"
            changed=1
        fi
    fi

    # Ensure 4 protocols exist (copy missing ones from data dir)
    for f in "${ASIMOV_PROTOCOLS[@]}"; do
        if [ ! -f ".asimov/${f}" ] && [ -f "${DATA_DIR}/protocols/${f}" ]; then
            cp "${DATA_DIR}/protocols/${f}" ".asimov/${f}"
            echo "Added .asimov/${f}"
            changed=1
        fi
    done

    # Update pre-commit hook if git repo
    if [ -d .git ] && [ -f "${DATA_DIR}/hooks/pre-commit" ]; then
        cp "${DATA_DIR}/hooks/pre-commit" .git/hooks/pre-commit
        chmod +x .git/hooks/pre-commit
        echo "Updated pre-commit hook"
        changed=1
    fi

    # Warn about unexpected files
    local expected="project.yaml roadmap.yaml freshness.json sycophancy.json sprint.json coding-standards.json launch.yaml"
    local orphans=""
    for f in .asimov/*; do
        [ -e "$f" ] || continue
        local base
        base=$(basename "$f")
        if ! echo "$expected" | grep -qw "$base"; then
            orphans="${orphans}  ${f}\n"
        fi
    done
    if [ -n "$orphans" ]; then
        echo ""
        echo "Unexpected files in .asimov/ (review manually):"
        printf '%b' "$orphans"
        changed=1
    fi

    if [ "$changed" -eq 0 ]; then
        echo "Already up to date."
    else
        echo ""
        echo "Migration complete."
    fi
}

# ─── Update ───────────────────────────────────────────────────────────────

# Release files, relative to the repo root. Checked against SHA256SUMS.
release_files() {
    echo "bin/asimov"
    echo "hooks/pre-commit"
    for f in "${ASIMOV_PROTOCOLS[@]}"; do echo "protocols/${f}"; done
}

sha256_of() {
    if command -v sha256sum &>/dev/null; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

cmd_update() {
    check_deps
    local api="https://api.github.com/repos/${ASIMOV_REPO}/releases/latest"
    local bin_path
    bin_path="$(realpath "$0")"

    echo "Checking for updates..."
    local tag
    tag="$(curl -fsSL "$api" | jq -r '.tag_name // empty')" || tag=""
    if [ -z "$tag" ]; then
        echo "update: failed to fetch latest release from ${api}" >&2; exit 1
    fi
    local latest_version="${tag#v}"

    if [ "$latest_version" = "$ASIMOV_VERSION" ]; then
        echo "Already up to date. (v${ASIMOV_VERSION})"
        return 0
    fi

    echo "Updating asimov v${ASIMOV_VERSION} → v${latest_version}..."

    # Download everything for that tag into a staging dir, verify, then install
    local raw="https://raw.githubusercontent.com/${ASIMOV_REPO}/${tag}"
    local sums_url="https://github.com/${ASIMOV_REPO}/releases/download/${tag}/SHA256SUMS"
    local stage; stage="$(mktemp -d)"
    if ! curl -fsSL "$sums_url" -o "${stage}/SHA256SUMS"; then
        rm -rf "$stage"
        echo "update: failed to fetch SHA256SUMS for ${tag}" >&2; exit 1
    fi
    local f expected actual
    while IFS= read -r f; do
        mkdir -p "${stage}/$(dirname "$f")"
        if ! curl -fsSL "${raw}/${f}" -o "${stage}/${f}"; then
            rm -rf "$stage"
            echo "update: failed to fetch ${f}" >&2; exit 1
        fi
        expected="$(awk -v p="$f" '$2 == p {print $1}' "${stage}/SHA256SUMS")"
        actual="$(sha256_of "${stage}/${f}")"
        if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then
            rm -rf "$stage"
            echo "update: checksum mismatch for ${f}; nothing was changed" >&2; exit 1
        fi
    done < <(release_files)

    # All verified: install
    mkdir -p "${DATA_DIR}/protocols" "${DATA_DIR}/hooks"
    for f in "${ASIMOV_PROTOCOLS[@]}"; do
        cp "${stage}/protocols/${f}" "${DATA_DIR}/protocols/${f}"
    done
    cp "${stage}/hooks/pre-commit" "${DATA_DIR}/hooks/pre-commit"
    chmod +x "${DATA_DIR}/hooks/pre-commit"
    chmod +x "${stage}/bin/asimov"
    mv "${stage}/bin/asimov" "$bin_path"
    rm -rf "$stage"

    echo "Updated to v${latest_version}."
    echo "Run 'asimov migrate' in each project to refresh its pre-commit hook."
}

# ─── Build mode (v3) ─────────────────────────────────────────────────────
# asimov build <spec>... : ingest specs, plan, stop for approval, scaffold.
# Design: docs/design/build-mode.md

BUILD_DIR=""
BUILD_STATE=""

build_init_paths() {
    BUILD_DIR="$(cd "$1" && pwd)"
    BUILD_STATE="${BUILD_DIR}/.asimov-build"
}

state_file() { echo "${BUILD_STATE}/state.yaml"; }

state_get() {
    cfg_get "$(state_file)" ".$1"
}

state_set() {
    local key="$1" val="$2"
    VAL="$val" yq -i ".${key} = strenv(VAL)" "$(state_file)"
}

build_fail() {
    echo "build: $*" >&2
    exit 1
}

# Tools a build needs, given its specs
build_check_tools() {
    local ai="$1"; shift
    local missing=() need_ref=0 need_pandoc=0 s
    for s in "$@"; do
        case "$s" in
            http://*|https://*|*.pdf|*.PDF) need_ref=1 ;;
            *.docx|*.DOCX) need_pandoc=1 ;;
        esac
    done
    command -v git &>/dev/null || missing+=("git")
    command -v "$ai" &>/dev/null || missing+=("$ai")
    [ "$need_ref" -eq 1 ] && ! command -v ref &>/dev/null && missing+=("ref (for PDF and URL specs: https://github.com/mollendorff-ai/ref)")
    [ "$need_pandoc" -eq 1 ] && ! command -v pandoc &>/dev/null && missing+=("pandoc (for .docx specs: brew install pandoc)")
    if [ ${#missing[@]} -gt 0 ]; then
        echo "build: missing tools:" >&2
        printf '  %s\n' "${missing[@]}" >&2
        exit 1
    fi
}

build_check_sandbox() {
    local ack
    ack="$(cfg_get "$ASIMOV_GLOBAL_CONFIG" '.build.sandbox')"
    if [ "$ack" != "true" ]; then
        cat >&2 << EOF
build: build mode runs an AI agent with no approval prompts, unattended.
Run it only in a sandbox (VM, container, throwaway machine). When you are in
one, say so once by adding this to ${ASIMOV_GLOBAL_CONFIG}:

build:
  sandbox: true
EOF
        exit 1
    fi
}

# Ref JSON (fetch or pdf) on stdin -> Markdown on stdout
ref_json_to_md() {
    jq -r '
        (if type == "array" then .[0] else . end) as $p
        | ("# " + ($p.title // $p.url // "Spec")),
          "",
          ($p.sections[]? | (("#" * ([.level + 1, 6] | min)) + " " + .heading), "", .content, ""),
          ($p.code[]? | ("```" + (.lang // "")), .source, "```", "")
    '
}

ref_json_status() {
    jq -r '(if type == "array" then .[0] else . end) | .status // "ok"'
}

spec_slug() {
    local s="$1"
    s="${s#http://}"; s="${s#https://}"
    s="$(basename "$s")"
    s="${s%.*}"
    s="$(printf '%s' "$s" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/--*/-/g; s/^-//; s/-$//')"
    [ -z "$s" ] && s="spec"
    printf '%s' "${s:0:40}"
}

# Copy or convert every spec into .asimov-build/specs/ as Markdown
build_ingest() {
    local specs_dir="${BUILD_STATE}/specs" sources="${BUILD_STATE}/sources.yaml"
    mkdir -p "$specs_dir"
    echo "sources: []" > "$sources"
    local i=0 s out type status json
    for s in "$@"; do
        i=$((i + 1))
        out="$(printf '%02d' "$i")-$(spec_slug "$s").md"
        status="ok"
        case "$s" in
            http://*|https://*)
                type="url"
                json="$(ref fetch --max-chars 0 --max-sections 0 "$s" 2>/dev/null)" \
                    || build_fail "ref fetch failed for ${s}"
                status="$(printf '%s' "$json" | ref_json_status)"
                printf '%s' "$json" | ref_json_to_md > "${specs_dir}/${out}"
                ;;
            *)
                [ -f "$s" ] || build_fail "spec not found: ${s}"
                s="$(cd "$(dirname "$s")" && pwd)/$(basename "$s")"
                case "$s" in
                    *.md|*.markdown|*.txt|*.MD|*.TXT)
                        type="text"; cp "$s" "${specs_dir}/${out}" ;;
                    *.pdf|*.PDF)
                        type="pdf"
                        json="$(ref pdf "$s" 2>/dev/null)" || build_fail "ref pdf failed for ${s}"
                        printf '%s' "$json" | ref_json_to_md > "${specs_dir}/${out}"
                        ;;
                    *.docx|*.DOCX)
                        type="docx"
                        pandoc -t gfm "$s" -o "${specs_dir}/${out}" || build_fail "pandoc failed for ${s}"
                        ;;
                    *) build_fail "unsupported spec type: ${s} (use .md, .txt, .pdf, .docx or a URL)" ;;
                esac
                ;;
        esac
        SPEC="$out" SRC="$s" TYPE="$type" STATUS="$status" \
            yq -i '.sources += [{"spec": strenv(SPEC), "source": strenv(SRC), "type": strenv(TYPE), "status": strenv(STATUS)}]' "$sources"
        echo "  ${out}  ← ${s}"
    done
}

# Any URL spec behind a wall stops the build before planning
build_check_sources() {
    local sources="${BUILD_STATE}/sources.yaml" bad
    bad="$(yq -r '.sources[] | select(.status != "ok") | .status + " " + .source' "$sources")"
    [ -z "$bad" ] && return 0
    echo "build: some specs could not be read:" >&2
    while IFS= read -r line; do
        local st="${line%% *}" url="${line#* }"
        case "$st" in
            login|paywall)
                echo "  ${url}: ${st}. Run: ref login ${url}  (sign in, quit Chrome), then: asimov resume" >&2 ;;
            *)
                echo "  ${url}: ${st}. Fix or remove this spec, then run asimov build again." >&2 ;;
        esac
    done <<< "$bad"
    exit 1
}

# Load agent settings for build mode into AGENT_ARGS and the environment.
# build.<ai>.* wins; args and model fall back to launch.<ai>.*; env does not
# (build mode avoids the interactive maximum-thinking defaults).
load_build_agent() {
    local ai="$1" model args_list env_list
    model="$(cfg_get "$ASIMOV_GLOBAL_CONFIG" ".build.${ai}.model")"
    [ -z "$model" ] && model="$(cfg_get "$ASIMOV_GLOBAL_CONFIG" ".launch.${ai}.model")"
    args_list="$(cfg_list "$ASIMOV_GLOBAL_CONFIG" ".build.${ai}.args")"
    [ -z "$args_list" ] && args_list="$(cfg_list "$ASIMOV_GLOBAL_CONFIG" ".launch.${ai}.args")"
    if [ -z "$args_list" ]; then
        case "$ai" in
            claude) args_list="--dangerously-skip-permissions" ;;
            gemini) args_list="--approval-mode=yolo" ;;
            codex)  args_list="--full-auto" ;;
        esac
    fi
    env_list="$(cfg_env "$ASIMOV_GLOBAL_CONFIG" ".build.${ai}.env")"
    if [ -z "$env_list" ]; then
        case "$ai" in claude) env_list="CLAUDE_CODE_EFFORT_LEVEL=high" ;; esac
    fi
    [ -z "$model" ] && [ "$ai" = "claude" ] && model="opus"

    while IFS= read -r line; do
        # shellcheck disable=SC2163
        [ -n "$line" ] && export "$line"
    done <<< "$env_list"
    AGENT_ARGS=()
    while IFS= read -r arg; do
        [ -n "$arg" ] && AGENT_ARGS+=("$arg")
    done <<< "$args_list"
    [ -n "$model" ] && AGENT_ARGS+=("--model" "$model")
    return 0
}

# Run the agent headless in a folder: agent_run ai dir prompt logfile
agent_run() {
    local ai="$1" dir="$2" prompt="$3" log="$4"
    mkdir -p "$(dirname "$log")"
    (
        cd "$dir"
        case "$ai" in
            claude) claude "${AGENT_ARGS[@]}" -p "$prompt" ;;
            gemini) gemini "${AGENT_ARGS[@]}" -p "$prompt" ;;
            codex)  codex exec "${AGENT_ARGS[@]}" --skip-git-repo-check "$prompt" ;;
        esac
    ) > "$log" 2>&1
}

BUILD_PLAN_PROMPT='You are planning a software build. Read every file in specs/ in this folder; they are the specifications. Write exactly two files in this folder and nothing else: plan.yaml and ASSUMPTIONS.md. Do not write code, do not create folders, do not run git.

plan.yaml must have exactly this shape:

projects:
  - name: my-project        # folder name: lowercase letters, digits, dashes
    description: "One sentence: what it is and who it is for."
    stack: [rust]            # languages and main tools
    milestones:              # in build order, each small enough for a few agent sessions
      - version: "0.1.0"
        title: "Short title"
        deliverables:
          - "Concrete thing that will exist"
        acceptance:
          - "Testable statement a test can check"

Rules:
- One project unless the specs describe separate deliverables (for example a server and a client); then one project per deliverable.
- Versions are semantic versions starting at 0.1.0 and increasing.
- Every acceptance item must be checkable by an automated test.
- Never stop to ask a question. For every decision the specs leave open, choose and record it in ASSUMPTIONS.md as a bullet: the question, your choice, and why.'

# Check plan.yaml has the shape scaffold needs; print problems, return 1 if any
build_validate_plan() {
    local plan="${BUILD_STATE}/plan.yaml" problems=() n
    [ -f "$plan" ] || { echo "plan.yaml was not written"; return 1; }
    yq -e '.' "$plan" &>/dev/null || { echo "plan.yaml is not valid YAML"; return 1; }
    n="$(yq '.projects // [] | length' "$plan")"
    [ "$n" -gt 0 ] || problems+=("no projects")
    local name seen=" "
    while IFS= read -r name; do
        [ -z "$name" ] && continue
        [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || problems+=("bad project name '${name}' (lowercase letters, digits, dashes)")
        [[ "$seen" == *" ${name} "* ]] && problems+=("duplicate project name '${name}'")
        seen="${seen}${name} "
    done < <(yq -r '.projects // [] | .[].name // ""' "$plan")
    n="$(yq '[.projects // [] | .[] | select((.name // "") == "")] | length' "$plan")"
    [ "$n" -eq 0 ] || problems+=("${n} project(s) without a name")
    n="$(yq '[.projects // [] | .[] | select((.milestones // []) | length == 0)] | length' "$plan")"
    [ "$n" -eq 0 ] || problems+=("${n} project(s) without milestones")
    n="$(yq '[.projects // [] | .[].milestones // [] | .[] | select((.version // "") == "" or (.title // "") == "" or ((.deliverables // []) | length) == 0 or ((.acceptance // []) | length) == 0)] | length' "$plan")"
    [ "$n" -eq 0 ] || problems+=("${n} milestone(s) missing version, title, deliverables or acceptance")
    [ -f "${BUILD_STATE}/ASSUMPTIONS.md" ] || problems+=("ASSUMPTIONS.md was not written")
    if [ ${#problems[@]} -gt 0 ]; then
        printf '%s\n' "${problems[@]}"
        return 1
    fi
    return 0
}

build_plan() {
    local ai log problems
    ai="$(state_get ai)"
    log="${BUILD_STATE}/logs/plan-$(date +%Y%m%d-%H%M%S).log"
    rm -f "${BUILD_STATE}/plan.yaml" "${BUILD_STATE}/ASSUMPTIONS.md"
    echo "Planning with ${ai}..."
    load_build_agent "$ai"
    if ! agent_run "$ai" "$BUILD_STATE" "$BUILD_PLAN_PROMPT" "$log"; then
        build_fail "the planning run failed. Log: ${log}. Run asimov resume to retry."
    fi
    if ! problems="$(build_validate_plan)"; then
        echo "build: the plan is not usable:" >&2
        printf '%s\n' "$problems" | sed 's/^/  - /' >&2
        echo "Log: ${log}. Fix .asimov-build/plan.yaml by hand and run asimov approve, or run asimov resume to plan again." >&2
        state_set phase "plan_invalid"
        exit 1
    fi
    state_set phase "planned"
}

build_summary() {
    local plan="${BUILD_STATE}/plan.yaml" assumptions
    assumptions="$(grep -c '^[[:space:]]*[-*] ' "${BUILD_STATE}/ASSUMPTIONS.md" || true)"
    echo ""
    echo "Plan:"
    yq -r '.projects[] | "  " + .name + " (" + ((.stack // []) | join(", ")) + "): " + ((.milestones | length) | tostring) + " milestone(s)"' "$plan"
    # shellcheck disable=SC2016  # $n is a yq variable
    yq -r '.projects[] | .name as $n | .milestones[] | "    " + $n + " " + .version + "  " + .title' "$plan"
    echo "  Assumptions: ${assumptions} (in .asimov-build/ASSUMPTIONS.md)"
}

build_stop_for_approval() {
    state_set phase "awaiting_approval"
    build_summary
    cat << EOF

Review .asimov-build/plan.yaml and .asimov-build/ASSUMPTIONS.md in
${BUILD_DIR}. Edit them if needed, then run:

  asimov approve ${BUILD_DIR}
EOF
}

# Create one folder + git repo per project, with .asimov/ from the plan
build_scaffold() {
    local plan="${BUILD_STATE}/plan.yaml" ai count i name dir
    ai="$(state_get ai)"
    count="$(yq '.projects | length' "$plan")"
    for ((i = 0; i < count; i++)); do
        name="$(yq -r ".projects[$i].name" "$plan")"
        dir="${BUILD_DIR}/${name}"
        if [ -d "${dir}/.asimov" ]; then
            echo "  ${name}/ already scaffolded, skipping"
            continue
        fi
        if [ -d "$dir" ] && [ -n "$(ls -A "$dir")" ]; then
            build_fail "${dir} exists and is not empty; move it away or rename the project in plan.yaml"
        fi
        mkdir -p "$dir"
        git -C "$dir" init -q
        (cd "$dir" && cmd_init "$name") > "${BUILD_STATE}/logs/scaffold-${name}.log" 2>&1 \
            || build_fail "asimov init failed in ${dir}; see .asimov-build/logs/scaffold-${name}.log"

        yq -i ".description = (load(\"${plan}\") | .projects[$i].description // \"\") |
               .stack = (load(\"${plan}\") | .projects[$i].stack // [])" "${dir}/.asimov/project.yaml"
        yq -P ".projects[$i] | {\"current\": (.milestones[0] + {\"status\": \"autonomous\"}), \"backlog\": .milestones[1:]}" \
            "$plan" > "${dir}/.asimov/roadmap.yaml"

        mkdir -p "${dir}/docs/specs"
        cp "${BUILD_STATE}"/specs/*.md "${dir}/docs/specs/"
        cp "${BUILD_STATE}/ASSUMPTIONS.md" "${dir}/docs/ASSUMPTIONS.md"

        if command -v ref &>/dev/null; then
            case "$ai" in
                claude) printf '{\n  "mcpServers": {\n    "ref": {"command": "ref", "args": ["mcp"]}\n  }\n}\n' > "${dir}/.mcp.json" ;;
                gemini) mkdir -p "${dir}/.gemini"
                        printf '{\n  "mcpServers": {\n    "ref": {"command": "ref", "args": ["mcp"]}\n  }\n}\n' > "${dir}/.gemini/settings.json" ;;
            esac
        fi
        echo "  ${name}/  git repo, .asimov/, docs/specs/"
    done
    state_set phase "scaffolded"
    echo "Scaffolded in ${BUILD_DIR}."
}

# ─── Build: execute loop ─────────────────────────────────────────────────

BUILD_DEFAULT_MAX_LOOPS=40
BUILD_DEFAULT_MAX_HOURS=8
BUILD_DEFAULT_STALL=3

# Cap options shared by build, approve and resume. Sets CAP_* globals and
# REST (remaining arguments). Unknown options fail.
parse_cap_options() {
    CAP_LOOPS="" CAP_HOURS="" CAP_USD="" CAP_STALL="" REST=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --max-loops) CAP_LOOPS="${2:?--max-loops needs a number}"; shift 2 ;;
            --max-hours) CAP_HOURS="${2:?--max-hours needs a number}"; shift 2 ;;
            --max-usd)   CAP_USD="${2:?--max-usd needs an amount}"; shift 2 ;;
            --stall)     CAP_STALL="${2:?--stall needs a number}"; shift 2 ;;
            *)           REST+=("$1"); shift ;;
        esac
    done
    local v
    for v in "$CAP_LOOPS" "$CAP_HOURS" "$CAP_STALL"; do
        [ -z "$v" ] || [[ "$v" =~ ^[0-9]+$ ]] || build_fail "caps must be whole numbers (got '${v}')"
    done
    [ -z "$CAP_USD" ] || [[ "$CAP_USD" =~ ^[0-9]+(\.[0-9]+)?$ ]] || build_fail "--max-usd must be an amount (got '${CAP_USD}')"
    return 0
}

# Store caps given on the command line; keep earlier ones otherwise
save_caps() {
    [ -n "$CAP_LOOPS" ] && state_set caps.max_loops "$CAP_LOOPS"
    [ -n "$CAP_HOURS" ] && state_set caps.max_hours "$CAP_HOURS"
    [ -n "$CAP_USD" ] && state_set caps.max_usd "$CAP_USD"
    [ -n "$CAP_STALL" ] && state_set caps.stall "$CAP_STALL"
    return 0
}

cap() {
    local v
    v="$(state_get "caps.$1")"
    [ -n "$v" ] && echo "$v" || echo "$2"
}

pstate_get() { state_get "projects[\"$1\"].$2"; }
pstate_set() { state_set "projects[\"$1\"].$2" "$3"; }

commit_count() {
    git -C "$1" rev-list --count HEAD 2>/dev/null || echo 0
}

# Give a repo a commit identity when the sandbox has none, so agents can commit
ensure_git_identity() {
    git -C "$1" config user.email &>/dev/null && return 0
    git -C "$1" config user.name "Asimov Build"
    git -C "$1" config user.email "asimov-build@localhost"
}

# Write roadmap.yaml for milestone index i of project p from the plan
write_roadmap() {
    local p="$1" i="$2" dir="$3" plan="${BUILD_STATE}/plan.yaml"
    if [ "$i" -eq 0 ]; then
        yq -P ".projects[$p] | {\"current\": (.milestones[0] + {\"status\": \"autonomous\"}), \"backlog\": .milestones[1:]}" \
            "$plan" > "${dir}/.asimov/roadmap.yaml"
    else
        yq -P ".projects[$p] | {\"current\": (.milestones[$i] + {\"status\": \"autonomous\"}),
            \"previous\": {\"version\": .milestones[$((i - 1))].version, \"title\": .milestones[$((i - 1))].title},
            \"backlog\": .milestones[$((i + 1)):]}" "$plan" > "${dir}/.asimov/roadmap.yaml"
    fi
}

BUILD_LOOP_PROMPT='You are building this project unattended. Nobody will answer questions. Work on the current milestone in .asimov/roadmap.yaml. The specifications are in docs/specs/ and the planning assumptions in docs/ASSUMPTIONS.md.

1. Write tests from the milestone acceptance criteria first.
2. Implement until every test passes.
3. Commit in small steps. Every commit goes through the pre-commit quality gate (format, lint, 100% coverage). If it fails, fix the code. Never bypass it.
4. When every deliverable exists and every acceptance criterion has a passing test: set current.status to released in .asimov/roadmap.yaml, add the milestone to CHANGELOG.md, and commit. Do not edit any other part of roadmap.yaml; Asimov moves to the next milestone.
5. If you cannot continue (a credential you do not have, a contradiction in the specs, a tool you cannot install), write BLOCKED.md in the project root saying exactly what is needed, and stop.
6. Record every new decision in docs/ASSUMPTIONS.md instead of asking.'

# One agent run in a project; prints the run cost in USD (0 if unknown)
build_agent_turn() {
    local ai="$1" dir="$2" prompt="$3" log="$4" budget="$5" sp first
    sp="$(cd "$dir" && build_system_prompt)"
    mkdir -p "$(dirname "$log")"
    (
        cd "$dir"
        case "$ai" in
            claude)
                local extra=(--output-format json)
                [ -n "$sp" ] && extra+=(--append-system-prompt "$sp")
                [ -n "$budget" ] && extra+=(--max-budget-usd "$budget")
                claude "${AGENT_ARGS[@]}" "${extra[@]}" -p "$prompt" ;;
            gemini|codex)
                first=""
                [ -n "$sp" ] && first="Follow these project rules for the whole session (JSON): ${sp}

"
                if [ "$ai" = "gemini" ]; then
                    gemini "${AGENT_ARGS[@]}" -p "${first}${prompt}"
                else
                    codex exec "${AGENT_ARGS[@]}" "${first}${prompt}"
                fi ;;
        esac
    ) > "$log" 2>&1 || true
    if [ "$ai" = "claude" ]; then
        jq -r 'select(type == "object") | .total_cost_usd // 0' "$log" 2>/dev/null | tail -1 | grep . || echo 0
    else
        echo 0
    fi
}

# Links in README and docs must work before a milestone counts as released.
# Returns 0 when fine (or ref is missing), 1 with the report in $2.
build_link_check() {
    local dir="$1" report="$2" files=() f
    command -v ref &>/dev/null || return 0
    [ -f "${dir}/README.md" ] && files+=("${dir}/README.md")
    for f in "${dir}"/docs/*.md; do
        [ -f "$f" ] && files+=("$f")
    done
    [ ${#files[@]} -gt 0 ] || return 0
    local ok=0
    : > "$report"
    for f in "${files[@]}"; do
        ref check-links "$f" >> "$report" 2>/dev/null || ok=1
    done
    return "$ok"
}

build_stop() {
    state_set phase "stopped"
    state_set stop_reason "$1"
    echo ""
    echo "Build stopped: $1"
    echo "Fix the cause, then: asimov resume ${BUILD_DIR}  (caps can be raised with the same options)"
    exit 2
}

build_execute() {
    local plan="${BUILD_STATE}/plan.yaml" ai count p name dir
    ai="$(state_get ai)"
    count="$(yq '.projects | length' "$plan")"
    local max_loops max_hours max_usd stall_cap deadline
    max_loops="$(cap max_loops "$BUILD_DEFAULT_MAX_LOOPS")"
    max_hours="$(cap max_hours "$BUILD_DEFAULT_MAX_HOURS")"
    max_usd="$(cap max_usd "")"
    stall_cap="$(cap stall "$BUILD_DEFAULT_STALL")"
    deadline=$(( $(date +%s) + max_hours * 3600 ))
    state_set phase "executing"
    load_build_agent "$ai"

    for ((p = 0; p < count; p++)); do
        name="$(yq -r ".projects[$p].name" "$plan")"
        dir="${BUILD_DIR}/${name}"
        [ "$(pstate_get "$name" finished)" = "true" ] && continue
        ensure_git_identity "$dir"
        local idx milestones loops stall
        idx="$(pstate_get "$name" milestone)"; idx="${idx:-0}"
        milestones="$(yq ".projects[$p].milestones | length" "$plan")"
        echo ""
        echo "Building ${name} (milestone $((idx + 1)) of ${milestones})..."

        while true; do
            [ -f "${dir}/BLOCKED.md" ] && build_stop "${name}: the agent is blocked, see ${dir}/BLOCKED.md (delete it once solved)"
            loops="$(pstate_get "$name" loops)"; loops="${loops:-0}"
            stall="$(pstate_get "$name" stall)"; stall="${stall:-0}"
            [ "$loops" -ge "$max_loops" ] && build_stop "${name}: reached ${max_loops} agent runs (--max-loops)"
            [ "$stall" -ge "$stall_cap" ] && build_stop "${name}: ${stall} runs in a row without a new commit (--stall)"
            [ "$(date +%s)" -ge "$deadline" ] && build_stop "reached ${max_hours} hours (--max-hours)"
            local spent budget=""
            spent="$(state_get spent_usd)"; spent="${spent:-0}"
            if [ -n "$max_usd" ]; then
                budget="$(awk -v m="$max_usd" -v s="$spent" 'BEGIN { r = m - s; printf "%.2f", (r > 0 ? r : 0) }')"
                awk -v b="$budget" 'BEGIN { exit !(b <= 0) }' && build_stop "spent \$${spent} of \$${max_usd} (--max-usd)"
            fi

            local version before after cost prompt="$BUILD_LOOP_PROMPT" report
            version="$(yq -r '.current.version' "${dir}/.asimov/roadmap.yaml")"
            report="${BUILD_STATE}/logs/links-${name}.json"
            if [ "$(pstate_get "$name" links_failed)" = "true" ]; then
                prompt="${prompt}

The milestone was marked released, but these links in README.md or docs/ are broken. Fix them, then mark it released again:
$(head -c 4000 "$report")"
            fi
            before="$(commit_count "$dir")"
            loops=$((loops + 1))
            echo "  run ${loops}: ${name} ${version}"
            cost="$(build_agent_turn "$ai" "$dir" "$prompt" \
                "${BUILD_STATE}/logs/${name}-run-$(printf '%03d' "$loops").log" "$budget")"
            after="$(commit_count "$dir")"
            pstate_set "$name" loops "$loops"
            state_set spent_usd "$(awk -v s="$spent" -v c="$cost" 'BEGIN { printf "%.4f", s + c }')"
            if [ "$after" -gt "$before" ]; then
                pstate_set "$name" stall 0
            else
                pstate_set "$name" stall $((stall + 1))
            fi

            # Released? (status set, or the agent moved it to previous itself)
            local status prev
            status="$(yq -r '.current.status // ""' "${dir}/.asimov/roadmap.yaml" 2>/dev/null)"
            prev="$(yq -r '.previous.version // ""' "${dir}/.asimov/roadmap.yaml" 2>/dev/null)"
            if [ "$status" != "released" ] && ! { [ "$prev" = "$version" ] && [ "$(yq -r '.current.version // ""' "${dir}/.asimov/roadmap.yaml")" != "$version" ]; }; then
                continue
            fi
            if ! build_link_check "$dir" "$report"; then
                echo "  ${name} ${version}: broken links, sending back"
                pstate_set "$name" links_failed true
                yq -i '.current.status = "autonomous"' "${dir}/.asimov/roadmap.yaml"
                continue
            fi
            pstate_set "$name" links_failed false
            echo "  ${name} ${version}: released"
            idx=$((idx + 1))
            pstate_set "$name" milestone "$idx"
            if [ "$idx" -ge "$milestones" ]; then
                pstate_set "$name" finished true
                break
            fi
            write_roadmap "$p" "$idx" "$dir"
        done
    done

    state_set phase "done"
    echo ""
    echo "Build done: every milestone of every project is released."
    yq -r '.projects | to_entries[] | "  " + .key + ": " + (.value.loops | tostring) + " runs"' "$(state_file)"
    local spent
    spent="$(state_get spent_usd)"
    [ -n "$spent" ] && [ "$ai" = "claude" ] && echo "  Spend: \$${spent}"
    return 0
}

# Run the build from whatever phase state.yaml records
build_continue() {
    local phase
    phase="$(state_get phase)"
    case "$phase" in
        ingested)
            build_plan
            build_continue ;;
        planned)
            if [ "$(state_get approved)" = "true" ]; then
                build_scaffold
                build_continue
            else
                build_stop_for_approval
            fi ;;
        plan_invalid)
            build_plan
            build_continue ;;
        awaiting_approval)
            build_stop_for_approval ;;
        approved)
            build_scaffold
            build_continue ;;
        scaffolded|executing|stopped)
            build_execute ;;
        done)
            echo "Build already done: every milestone of every project is released." ;;
        *)
            build_fail "unknown build phase '${phase}' in $(state_file)" ;;
    esac
}

cmd_build() {
    check_deps
    ensure_global_config
    parse_cap_options "$@"
    set -- ${REST[@]+"${REST[@]}"}
    local dir="." ai="" yes=0 specs=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --dir)  dir="${2:?--dir needs a path}"; shift 2 ;;
            --ai)   ai="${2:?--ai needs claude, gemini or codex}"; shift 2 ;;
            --yes)  yes=1; shift ;;
            -h|--help) show_build_help; return 0 ;;
            -*)     build_fail "unknown option $1 (asimov build --help)" ;;
            *)      specs+=("$1"); shift ;;
        esac
    done
    [ ${#specs[@]} -gt 0 ] || build_fail "no specs given (asimov build --help)"
    [ -z "$ai" ] && ai="$(cfg_get "$ASIMOV_GLOBAL_CONFIG" '.build.default_ai')"
    [ -z "$ai" ] && ai="$(cfg_get "$ASIMOV_GLOBAL_CONFIG" '.launch.default_ai')"
    [ -z "$ai" ] && ai="claude"
    case "$ai" in claude|gemini|codex) ;; *) build_fail "unknown AI '${ai}' (claude, gemini or codex)" ;; esac

    build_check_sandbox
    build_check_tools "$ai" "${specs[@]}"
    mkdir -p "$dir"
    build_init_paths "$dir"
    if [ -f "$(state_file)" ]; then
        build_fail "${BUILD_STATE} already exists; run asimov resume, or remove it to start over"
    fi
    mkdir -p "${BUILD_STATE}/logs"
    printf 'phase: new\n' > "$(state_file)"
    state_set ai "$ai"
    state_set approved "$([ "$yes" -eq 1 ] && echo true || echo false)"
    state_set started "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    save_caps

    echo "Reading specs..."
    build_ingest "${specs[@]}"
    build_check_sources
    state_set phase "ingested"
    build_continue
}

cmd_approve() {
    check_deps
    parse_cap_options "$@"
    build_init_paths "${REST[0]:-.}"
    [ -f "$(state_file)" ] || build_fail "no build in ${BUILD_DIR} (no .asimov-build/state.yaml)"
    local phase problems
    phase="$(state_get phase)"
    case "$phase" in
        awaiting_approval|planned|plan_invalid) ;;
        *) build_fail "nothing to approve (phase: ${phase})" ;;
    esac
    if ! problems="$(build_validate_plan)"; then
        echo "build: the plan is not usable:" >&2
        printf '%s\n' "$problems" | sed 's/^/  - /' >&2
        exit 1
    fi
    state_set approved "true"
    state_set phase "approved"
    save_caps
    echo "Plan approved."
    build_continue
}

cmd_resume() {
    check_deps
    parse_cap_options "$@"
    build_init_paths "${REST[0]:-.}"
    [ -f "$(state_file)" ] || build_fail "no build in ${BUILD_DIR} (no .asimov-build/state.yaml)"
    save_caps
    # A stall or block was the reason to stop: start counting afresh
    if [ "$(state_get phase)" = "stopped" ]; then
        local n
        while IFS= read -r n; do
            [ -n "$n" ] && pstate_set "$n" stall 0
        done < <(yq -r '.projects // {} | keys | .[]' "$(state_file)")
    fi
    local ai
    ai="$(state_get ai)"
    build_check_sandbox
    build_check_tools "$ai"
    # A spec behind a login: refetch URL specs that were not ok
    if [ "$(yq '[.sources[] | select(.status != "ok")] | length' "${BUILD_STATE}/sources.yaml")" -gt 0 ]; then
        local urls=() src
        while IFS= read -r src; do
            urls+=("$src")
        done < <(yq -r '.sources[].source' "${BUILD_STATE}/sources.yaml")
        echo "Re-reading specs..."
        build_ingest "${urls[@]}"
        build_check_sources
        state_set phase "ingested"
    fi
    build_continue
}

show_build_help() {
    cat << 'EOF'
asimov build [options] <spec>...   read specs, plan, stop for approval
asimov approve [dir] [caps]        approve the plan, scaffold, build
asimov resume [dir] [caps]         continue after a stop or a crash

Specs: .md, .txt, .pdf (needs ref), .docx (needs pandoc), or a URL (needs ref).

Options:
    --dir <path>    build folder (default: current folder)
    --ai <name>     claude, gemini or codex (default: build.default_ai,
                    then launch.default_ai)
    --yes           skip the approval stop

Caps (build, approve and resume; a build never runs open-ended):
    --max-loops <n> agent runs per project (default 40)
    --max-hours <h> hours per build session (default 8)
    --max-usd <x>   total spend, Claude only (default: none)
    --stall <n>     stop after n runs with no new commit (default 3)

Needs build.sandbox: true in ~/.asimov/config.yaml (sandbox only).
Design: docs/design/build-mode.md
EOF
}

# ─── Help ────────────────────────────────────────────────────────────────

show_help() {
    cat << EOF
asimov v${ASIMOV_VERSION} - full-autonomy launcher for AI coding CLIs (sandbox use)

USAGE:
    asimov              Launch AI CLI with protocols (default)
    asimov init [name]  Initialize .asimov/ in current project
    asimov migrate      Update .asimov/ to latest format
    asimov update       Install the latest tagged release (checksum-verified)
    asimov build <spec>...  Plan projects from specs, stop for approval, scaffold
    asimov approve [dir]    Approve a build plan, scaffold and build
    asimov resume [dir]     Continue a stopped build (asimov build --help)
    asimov --help       Show this help
    asimov --version    Show version

DEPENDENCIES:
    yq                  mikefarah/yq v4, the Go version (brew install yq)
    jq                  JSON parser (brew install jq)

CONFIGURATION:
    Global:  ~/.asimov/config.yaml
    Project: .asimov/launch.yaml (overrides global)

PROTOCOLS (Claude: system prompt; Gemini/Codex: first message):
    .asimov/freshness.json          Prefer ref fetch for web content when installed
    .asimov/sycophancy.json         Truth over comfort
    .asimov/sprint.json             Autonomous mode triggers
    .asimov/coding-standards.json   Code quality principles

QUALITY:
    Pre-commit hook enforces format + lint + 100% coverage.
    Run 'asimov init' to install the hook.

Docs: https://github.com/mollendorff-ai/asimov
EOF
}

# ─── Main ────────────────────────────────────────────────────────────────

case "${1:-}" in
    init)       shift; cmd_init "$@" ;;
    migrate)    cmd_migrate ;;
    update)     cmd_update ;;
    build)      shift; cmd_build "$@" ;;
    approve)    shift; cmd_approve "$@" ;;
    resume)     shift; cmd_resume "$@" ;;
    --help|-h)  show_help ;;
    --version)  echo "asimov ${ASIMOV_VERSION}" ;;
    "")         launch_ai ;;
    *)          echo "Unknown command: $1. Run 'asimov --help'" >&2; exit 1 ;;
esac
